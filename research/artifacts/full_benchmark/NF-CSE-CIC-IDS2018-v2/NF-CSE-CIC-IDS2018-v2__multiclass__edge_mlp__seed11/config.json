  "eval_every_steps": 0,
  "steps_per_full_pass": 3230,
  "train_passes": 0,
  "min_train_steps": 0,
  "evals_per_pass": 4,
  "training_budget_mode": "epochs",
  "num_workers": 4,
  "shared_feature_graph_across_tasks": true,
  "edge_storage_dtype": "torch.float16",
  "train_sampling": "LinkNeighborLoader directional; loss on seed edges",
  "validation_test": "full split graph"
}
